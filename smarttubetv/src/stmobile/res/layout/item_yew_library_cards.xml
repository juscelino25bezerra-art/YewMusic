<?xml version="1.0" encoding="utf-8"?>
<!-- YEWMUSIC(library): os dois cartões do topo da Biblioteca (Proposta 2) - Curtidas (só com login)
     e Baixadas, que tocam sem internet. Toque grande, nome e uma linha que diz o que há dentro. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/yew_side_margin"
    android:paddingTop="8dp"
    android:paddingEnd="@dimen/yew_side_margin"
    android:paddingBottom="12dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/yew_card_liked"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_marginEnd="12dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="#FF3A1820"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_yew_heart_fill"
                android:tint="#FFF2555A" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_bold"
                android:text="@string/yew_library_liked"
                android:textColor="#FFF4F4F5"
                android:textSize="17sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yew_library_liked_desc"
                android:textColor="#FFE8C9CF"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/yew_card_downloads"
        android:layout_width="0dp"
        android:layout_height="104dp"
        android:layout_weight="1"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        app:cardBackgroundColor="?attr/newtubeColorCard"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="14dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_watch_download"
                android:tint="@color/mobile_color_on_surface" />

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/instrument_bold"
                android:text="@string/yew_library_downloads"
                android:textColor="@color/mobile_color_on_surface"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/yew_card_downloads_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/yew_library_downloads_desc"
                android:textColor="@color/mobile_color_on_surface_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
