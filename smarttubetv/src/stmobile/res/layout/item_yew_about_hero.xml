<?xml version="1.0" encoding="utf-8"?>
<!-- YEWPLAY(about): o topo da tela Sobre (proposta, "Sobre numa tela só"): a gravura do teixo ao
     fundo, o ícone, o nome em Bricolage, a versão e de onde o app vem; abaixo, o resumo da licença
     e o que o nome quer dizer. Os grupos de linhas vêm depois, cada um com seu título. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-46dp"
        android:layout_marginEnd="-40dp"
        android:alpha="0.3"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_mobile_empty" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/yew_side_margin"
        android:paddingTop="20dp"
        android:paddingEnd="@dimen/yew_side_margin"
        android:paddingBottom="4dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/app_icon" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="48dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/yew_about_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:fontFamily="@font/bricolage_bold"
                    android:letterSpacing="-0.02"
                    android:textColor="@color/mobile_color_on_surface"
                    android:textSize="26sp"
                    tools:text="YewMusic" />

                <TextView
                    android:id="@+id/yew_about_version"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp"
                    tools:text="Versão 1.17.1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/yew_about_origin"
                    android:textColor="@color/mobile_color_on_surface_secondary"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_yew_note"
            android:lineSpacingMultiplier="1.1"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="12dp"
            android:text="@string/yew_about_free"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13.5sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.1"
            android:text="@string/yew_about_name_meaning"
            android:textColor="@color/mobile_color_on_surface_secondary"
            android:textSize="13.5sp" />
    </LinearLayout>
</FrameLayout>
